[
    {
        "name": "method",
        "type": "text",
        "label": "Method",
        "required": true,
        "help": "Formstep API method name, for example `me.get`, `forms.get`, or `submissions.list`. See https://docs.formstep.io/developers/rest-api."
    },
    {
        "name": "params",
        "type": "json",
        "label": "Parameters",
        "required": true,
        "default": {},
        "help": "JSON object containing method parameters. Use `{}` when the method takes no parameters."
    }
]
