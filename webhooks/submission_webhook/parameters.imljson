[
    {
        "name": "formId",
        "type": "select",
        "label": "Form",
        "required": true,
        "mappable": false,
        "help": "The form to watch. Public-link submissions only; a completed request fires Watch requests instead.",
        "options": {
            "store": "rpc://listForms"
        }
    },
    {
        "name": "eventType",
        "type": "select",
        "label": "Event",
        "required": true,
        "mappable": false,
        "default": "submission_created",
        "help": "Submission created fires once for each new submission (event type submission.completed). Submission updated fires when the respondent edits a submission they already sent (submission.updated); the form must allow editing after submit. Submission abandoned needs partial-submission tracking on the workspace.",
        "options": [
            {
                "label": "Submission created",
                "value": "submission_created"
            },
            {
                "label": "Submission updated",
                "value": "submission_updated"
            },
            {
                "label": "Submission abandoned",
                "value": "submission_abandoned",
                "nested": [
                    {
                        "name": "idleWindow",
                        "type": "select",
                        "label": "Consider submission abandoned after",
                        "required": true,
                        "mappable": false,
                        "default": "12h",
                        "help": "Fires after the submission has no saved changes for this long. The hourly sweep can add up to one hour.",
                        "options": [
                            {
                                "label": "12 hours",
                                "value": "12h"
                            },
                            {
                                "label": "1 day",
                                "value": "1d"
                            },
                            {
                                "label": "3 days",
                                "value": "3d"
                            },
                            {
                                "label": "1 week",
                                "value": "1w"
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
