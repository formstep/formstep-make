{
    "url": "/api/v1",
    "method": "POST",
    "condition": {
        "condition": "{{ifempty(parameters.formId, '') != ''}}",
        "default": "{{buildRequestInterface(emptyarray)}}"
    },
    "body": {
        "method": "fields.list",
        "params": {
            "formId": "{{parameters.formId}}"
        }
    },
    "response": {
        "output": "{{buildRequestInterface(body.data.items)}}"
    }
}
